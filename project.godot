; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes in []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Slidee"
config/description="Sliding puzzle from your own photos"
run/main_scene="res://scenes/Home.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://assets/icon.svg"
boot_splash/image=""
boot_splash/bg_color=Color(0.051, 0.067, 0.09, 1)

[autoload]

GameManager="*res://scripts/Autoload/GameManager.gd"
SaveManager="*res://scripts/Autoload/SaveManager.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

tap={
"deadzone": 0.5,
"events": [Object(InputEventScreenTouch,"resource_local_to_scene":false,"resource_name":"","device":-1,"index":0,"position":Vector2(0, 0),"pressed":false,"canceled":false,"double_tap":false,"script":null)
]
}

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.051, 0.067, 0.09, 1)

[android]

modules="org/godotengine/godot/plugin/GodotAndroid"
